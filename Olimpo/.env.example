# ==============================================================================
# OLIMPO SORTEADOR INSTAGRAM — VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ==============================================================================
# NUNCA comite suas chaves reais em repositórios públicos.
# Copie este arquivo para .env.local e preencha com seus dados reais.

# ------------------------------------------------------------------------------
# SUPABASE (Banco de Dados & Autenticação)
# ------------------------------------------------------------------------------
# Obtenha em: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon-publica"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-privada"

# ------------------------------------------------------------------------------
# META / INSTAGRAM GRAPH API (Oficial)
# ------------------------------------------------------------------------------
# Obtenha em: developers.facebook.com -> Seu App -> Configurações -> Básico
META_APP_ID="seu_meta_app_id"
META_APP_SECRET="seu_meta_app_secret"
NEXT_PUBLIC_META_REDIRECT_URI="http://localhost:3000/api/auth/meta/callback"

# ------------------------------------------------------------------------------
# APLICAÇÃO E SEGURANÇA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_SECRET="sua_chave_secreta_aleatoria_para_assinatura"